rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== YARDIMCI FONKSİYONLAR =====
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isEditor() {
      return isSignedIn() && getUserData().role == 'editor';
    }

    function isTipster() {
      return isSignedIn() && getUserData().role == 'tipster';
    }

    function hasRole() {
      return isSignedIn() && (isAdmin() || isEditor() || isTipster());
    }

    function isValidSize() {
      return request.resource.size() < 1048576;
    }

    function isSafeString(text) {
      return text is string && text.size() < 10000 &&
             !text.matches('.*<script.*') &&
             !text.matches('.*javascript:.*');
    }

    // ===== USERS COLLECTION =====
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidSize();
      allow update: if isSignedIn() &&
                       (request.auth.uid == userId || isAdmin()) &&
                       isValidSize() &&
                       (request.auth.uid == userId ? !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) : true);
      allow delete: if isAdmin();
    }

    // ===== COUNTERS (User ID sayacı) =====
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ===== PREDICTIONS (HERKES GÖREBİLİR) =====
    match /predictions/{predictionId} {
      allow read: if true;
      allow create: if hasRole() && isValidSize();
      allow update: if hasRole() && isValidSize();
      allow delete: if isAdmin();
    }

    // ===== MATCHES (HERKES GÖREBİLİR) =====
    match /matches/{matchId} {
      allow read: if true;
      allow create: if hasRole() && isValidSize();
      allow update: if hasRole() && isValidSize();
      allow delete: if isAdmin();
    }

    // ===== LIVE MATCHES =====
    match /liveMatches/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ===== COUPONS =====
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== KART & KORNER ANALİZ =====
    match /kartKornerData/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== SPOR HABERLERİ =====
    match /sporHaberleri/{docId} {
      allow read: if true;
      allow write: if hasRole();
    }

    // ===== DİĞER KATEGORİLER =====
    match /halfTimeGoals/{id} {
      allow read: if true;
      allow write: if hasRole();
    }

    match /dailyChoices/{id} {
      allow read: if true;
      allow write: if hasRole();
    }

    match /dailySurprises/{id} {
      allow read: if true;
      allow write: if hasRole();
    }

    // ===== NOTIFICATIONS =====
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ===== RATE LIMITS (Cloud Function için) =====
    match /rate_limits/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ===== GÜVENLİK: TÜM DİĞER ERİŞİMLER KAPALI =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
